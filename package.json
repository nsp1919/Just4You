{
  "name": "birthdayglow",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "migrate:referrals": "node scripts/migrate-referral-users.mjs",
    "test:referrals": "node --test scripts/tests/*.test.mjs",
    "start": "node server.js",
    "start:wish": "node server_wish.js",
    "package:hostinger": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-hostinger.ps1"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "undici": "^6.28.0",
    "sharp": "^0.35.3",
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": ">=18"
  }
}
