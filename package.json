{
  "name": "birthdayglow",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "migrate:referrals": "node scripts/migrate-referral-users.mjs",
    "test:referrals": "node --test scripts/tests/*.test.mjs",
    "start": "node server.js",
    "start:wish": "node server_wish.js",
    "package:hostinger": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-hostinger.ps1"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  },
  "overrides": {
    "brace-expansion@<1.1.18": "1.1.18",
    "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
    "brace-expansion@>=3.0.0 <3.0.6": "3.0.6",
    "brace-expansion@>=4.0.0 <5.0.9": "5.0.9",
    "postcss": "^8.5.23",
    "undici": "^6.28.0",
    "sharp": "^0.35.4",
    "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": ">=18"
  }
}
