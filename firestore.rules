rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admins (role == 'admin' on their own user doc) may read/manage all data.
    // Uses get() on the requester's user doc — safe because a user can always
    // read their own document.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ── Celebrations ──────────────────────────────────────────────────────────
    match /celebrations/{celebrationId} {
      function serverFieldsUnchanged() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'userId', 'paymentStatus', 'isActive', 'isBlocked', 'galleryApproved',
          'pricePaise', 'chargedPaise', 'slug', 'expiresAt', 'razorpayOrderId',
          'razorpayPaymentId', 'razorpayPaymentLinkId', 'razorpayPaymentLinkUrl',
          'referredBy', 'referralDiscountPaise', 'referralCreditAppliedInr',
          'walletAppliedInr', 'walletWithdrawableAppliedInr',
          'freeAddonFeatureId', 'freeAddonDiscountPaise',
          'checkoutFeatures', 'checkoutVanitySlug',
          'referralBenefitReservationId', 'referralBenefitsStatus',
          'referralBenefitsReservedAt', 'referralBenefitsReleasedAt',
          'referralBenefitsSettledAt', 'referralRewardSettled',
          'paymentWaived', 'activationSource', 'manualActivationAt',
          'manualActivationReason', 'launchAt', 'launchScheduledBy',
          'launchScheduleUpdatedAt', 'adminOrderEmailClaimedAt',
          'adminOrderEmailSentAt', 'creditText', 'creditUpdatedAt',
          'reviewMediaUrl', 'reviewMediaType', 'reviewVerified',
          'reviewVerifiedAt', 'paymentFulfilledAt',
          'customerConfirmationEmailClaimedAt', 'customerConfirmationEmailSentAt'
        ]);
      }

      function weddingCeremonyPosterOnly(index) {
        return resource.data.weddingData.ceremonies.size() <= index
          || (request.resource.data.weddingData.ceremonies[index]
                .diff(resource.data.weddingData.ceremonies[index])
                .affectedKeys().hasOnly(['image'])
              && (!request.resource.data.weddingData.ceremonies[index]
                    .diff(resource.data.weddingData.ceremonies[index])
                    .affectedKeys().hasAny(['image'])
                || (request.resource.data.weddingData.ceremonies[index].image is string
                  && request.resource.data.weddingData.ceremonies[index].image.size() <= 2048
                  && (request.resource.data.weddingData.ceremonies[index].image == ''
                    || request.resource.data.weddingData.ceremonies[index].image
                      .matches('https://res.cloudinary.com/.+')))));
      }

      function weddingCeremonyPostersOnly() {
        return request.resource.data.weddingData.ceremonies is list
          && request.resource.data.weddingData.ceremonies.size()
            == resource.data.weddingData.ceremonies.size()
          && weddingCeremonyPosterOnly(0)
          && weddingCeremonyPosterOnly(1)
          && weddingCeremonyPosterOnly(2)
          && weddingCeremonyPosterOnly(3)
          && weddingCeremonyPosterOnly(4)
          && weddingCeremonyPosterOnly(5);
      }

      function paidOwnerUpdateIsWeddingDetailsOnly() {
        return resource.data.paymentStatus != 'paid'
          || (resource.data.occasionType == 'wedding'
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['weddingData', 'recipientName', 'updatedAt'])
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasAll(['weddingData', 'updatedAt'])
              && request.resource.data.weddingData.diff(resource.data.weddingData)
                    .affectedKeys().hasOnly(['videoUrl', 'couple', 'ceremonies'])
                  && (!request.resource.data.weddingData.diff(resource.data.weddingData)
                  .affectedKeys().hasAny(['ceremonies'])
                 || weddingCeremonyPostersOnly())
              && (!request.resource.data.weddingData.diff(resource.data.weddingData)
                    .affectedKeys().hasAny(['videoUrl'])
                || (request.resource.data.weddingData.videoUrl is string
                  && request.resource.data.weddingData.videoUrl.size() <= 2048
                  && (request.resource.data.weddingData.videoUrl == ''
                    || request.resource.data.weddingData.videoUrl.matches('https?://.+'))))
              && ((!request.resource.data.diff(resource.data).affectedKeys()
                      .hasAny(['recipientName'])
                    && !request.resource.data.weddingData.diff(resource.data.weddingData)
                      .affectedKeys().hasAny(['couple']))
                || (request.resource.data.diff(resource.data).affectedKeys()
                      .hasAny(['recipientName'])
                  && request.resource.data.weddingData.diff(resource.data.weddingData)
                    .affectedKeys().hasAny(['couple'])
                  && request.resource.data.weddingData.couple.diff(resource.data.weddingData.couple)
                      .affectedKeys().hasOnly(['partnerOne', 'partnerTwo', 'monogram'])
                  && request.resource.data.weddingData.couple.partnerOne is string
                  && request.resource.data.weddingData.couple.partnerOne.size() > 0
                  && request.resource.data.weddingData.couple.partnerOne.size() <= 80
                  && request.resource.data.weddingData.couple.partnerTwo is string
                  && request.resource.data.weddingData.couple.partnerTwo.size() > 0
                  && request.resource.data.weddingData.couple.partnerTwo.size() <= 80
                  && request.resource.data.weddingData.couple.monogram is string
                  && request.resource.data.weddingData.couple.monogram.size() <= 12
                  && request.resource.data.recipientName
                    == request.resource.data.weddingData.couple.partnerOne
                      + ' & '
                      + request.resource.data.weddingData.couple.partnerTwo))
              && request.resource.data.updatedAt == request.time
          );
      }

      // OWNER: authenticated users can read/edit their own draft content, but
      // payment, activation, moderation, and referral fields remain server-only.
      allow read: if request.auth != null
          && request.auth.uid == resource.data.userId;
      allow update: if request.auth != null
            && request.auth.uid == resource.data.userId
        && serverFieldsUnchanged()
        && paidOwnerUpdateIsWeddingDetailsOnly();
      allow delete: if request.auth != null
            && request.auth.uid == resource.data.userId;

      // ADMIN: can read and moderate (e.g. block) any celebration.
      allow read, update: if isAdmin();

      // CREATE: Authenticated users can create new celebrations for themselves.
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId
                    && request.resource.data.paymentStatus == 'pending'
                    && request.resource.data.isActive == false
                    && request.resource.data.isBlocked == false
                    && request.resource.data.slug == ''
                    && request.resource.data.razorpayOrderId == ''
                    && !request.resource.data.keys().hasAny([
                      'chargedPaise', 'razorpayPaymentId', 'razorpayPaymentLinkId',
                      'razorpayPaymentLinkUrl', 'referredBy', 'referralDiscountPaise',
                      'referralCreditAppliedInr', 'walletAppliedInr',
                      'walletWithdrawableAppliedInr', 'freeAddonFeatureId',
                      'freeAddonDiscountPaise', 'referralBenefitReservationId',
                      'referralBenefitsStatus', 'referralBenefitsReservedAt',
                      'referralBenefitsReleasedAt', 'referralBenefitsSettledAt',
                      'referralRewardSettled', 'creditText', 'creditUpdatedAt'
                    ]);

      // ── Collaborative surprise settings (private invite token) ───────────
      match /collaboration/{settingsId} {
        allow read: if request.auth != null
                    && (request.auth.uid == get(/databases/$(database)/documents/celebrations/$(celebrationId)).data.userId
                        || isAdmin());
        allow write: if false;
      }

      // Contributions are created and moderated through the server API. The
      // public wish page can only query approved items after activation.
      match /contributions/{contributionId} {
        allow read: if (request.auth != null
                        && (request.auth.uid == get(/databases/$(database)/documents/celebrations/$(celebrationId)).data.userId
                            || isAdmin()))
                    || (resource.data.status == 'approved'
                        && get(/databases/$(database)/documents/celebrations/$(celebrationId)).data.isActive == true
                        && get(/databases/$(database)/documents/celebrations/$(celebrationId)).data.isBlocked == false);
        allow write: if false;
      }

      // ── Reactions sub-collection (public guestbook) ────────────────────────
      match /reactions/{reactionId} {
        // PUBLIC READ: Anyone can see reactions on active celebrations
        allow read: if get(/databases/$(database)/documents/celebrations/$(celebrationId)).data.isActive == true;

        // PUBLIC CREATE: Anyone can leave a reaction (no auth required)
        // Validate fields to prevent abuse
        allow create: if request.resource.data.keys().hasOnly(["emoji", "name", "message", "createdAt"])
                      && request.resource.data.name is string
                      && request.resource.data.name.size() <= 40
                      && request.resource.data.emoji is string
                      && request.resource.data.emoji.size() <= 8
                      && (request.resource.data.message is string || !("message" in request.resource.data))
                      && (!("message" in request.resource.data) || request.resource.data.message.size() <= 100);

        // No update or delete by public
        allow update, delete: if false;
      }

      // ── Wedding RSVPs ─────────────────────────────────────────────────────
      match /rsvps/{rsvpId} {
        // Invitation owners and admins can review attendance responses.
        allow read: if request.auth != null
                    && (request.auth.uid == get(/databases/$(database)/documents/celebrations/$(celebrationId)).data.userId
                        || isAdmin());

        // Guests may submit a tightly validated response only while the
        // invitation is active. Payment and owner data cannot be modified.
        allow create: if get(/databases/$(database)/documents/celebrations/$(celebrationId)).data.isActive == true
                      && get(/databases/$(database)/documents/celebrations/$(celebrationId)).data.isBlocked == false
                      && request.resource.data.keys().hasOnly([
                        'name', 'attending', 'ceremonies', 'guestCount', 'team', 'createdAt'
                      ])
                      && request.resource.data.name is string
                      && request.resource.data.name.size() > 0
                      && request.resource.data.name.size() <= 40
                      && request.resource.data.attending in ['yes', 'no']
                      && request.resource.data.ceremonies is list
                      && request.resource.data.ceremonies.size() <= 6
                      && request.resource.data.guestCount is int
                      && request.resource.data.guestCount >= 0
                      && request.resource.data.guestCount <= 10
                      && request.resource.data.team in ['', 'bride', 'groom']
                      && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }

      // ── View log sub-collection (written by server only) ──────────────────
      match /viewLog/{logId} {
        // OWNER: can read their own view logs for analytics
        allow read: if request.auth != null
                    && request.auth.uid == get(/databases/$(database)/documents/celebrations/$(celebrationId)).data.userId;
        // No client-side writes — handled by server-side Admin SDK
        allow write: if false;
      }
    }

    // Vanity names are reserved atomically by the checkout server. Clients
    // cannot claim, replace, or enumerate these ownership records.
    match /vanityLinks/{vanitySlug} {
      allow read, write: if false;
    }

    // Social-post reward claims are server-managed. Admin approval performs
    // the wallet credit transaction; clients cannot self-award credit.
    match /socialRewardClaims/{claimId} {
      allow read, write: if false;
    }

    // Free pre-purchase reminders contain private email addresses and are
    // created, delivered, and unsubscribed exclusively through server routes.
    match /occasionReminders/{reminderId} {
      allow read, write: if false;
    }

    match /draftRecoveries/{userId} {
      allow read, write: if false;
    }

    // Minor name/date corrections are submitted and reviewed through
    // authenticated server APIs. Clients cannot alter or approve requests.
    match /celebrationEditRequests/{requestId} {
      allow read, write: if false;
    }

    match /adminAuditLogs/{logId} {
      allow read, write: if false;
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Fields that only the server (Admin SDK) may set/change. The Admin SDK
      // bypasses these rules, so protecting them here blocks client tampering
      // (e.g. a user granting themselves referral credits or admin role).
      function protectedUnchanged() {
        return !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['role', 'isBlocked', 'referralCode', 'referredBy',
                   'referralCredits', 'walletBalance', 'referralJoinBonusGranted',
                   'referralRedeemed', 'referralCount', 'freeAddonCredits',
                   'referralDiscountReservationCelebrationId',
                   'walletWithdrawableBalance', 'pendingWalletWithdrawalId',
                   'socialShareRewardTotal']);
      }

      // Users can read only their own document.
      allow read: if request.auth != null && request.auth.uid == userId;

      // ADMIN: can read every user (for the admin dashboard) and toggle a
      // user's `isBlocked` flag. Admins still cannot grant roles or credits.
      allow read: if isAdmin();
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isBlocked']);

      // User profiles and referral attribution are created by the Admin SDK.
      allow create: if false;

      // UPDATE: a user may edit their own profile but never the protected fields.
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && protectedUnchanged();

      allow delete: if false;
    }

    // Bank details and payout state are available only through authenticated
    // server routes using the Admin SDK. Account numbers are encrypted at rest.
    match /walletWithdrawals/{withdrawalId} {
      allow read, write: if false;
    }

    // ── Admin-only: everything else blocked by default ─────────────────────
  }
}
